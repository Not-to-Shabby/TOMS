# Copy to .env (never commit .env). Real values come from your own secrets, not this file.
PORT=3000
DATABASE_URL=postgres://toms_user:CHANGE_ME@localhost:5432/toms_db

# Signs login tokens. At least 32 characters; the server refuses to start with a short or
# placeholder value. Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Comma-separated browser origins allowed to call the API, for example the dashboard URL.
# Leave empty to allow none. There is no wildcard.
CORS_ORIGINS=http://localhost:5173

# The public address printed into card QR codes, e.g. https://toms.example.com (no trailing slash).
# Set it before printing any cards: printed QR codes cannot be changed afterwards.
PUBLIC_BASE_URL=

# Time zone used for "today" and the report date filters.
REPORT_TIMEZONE=Asia/Manila

# Used by docker-compose.yml
POSTGRES_USER=toms_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=toms_db

# Used by the web container: LAN address(es) of this PC to put in the self-signed HTTPS certificate,
# so phones on the same Wi-Fi can open https://<that address>:5173. Comma-separated.
# Set it in .env before the first start; to change it later, remove the web_certs volume.
TLS_EXTRA_IPS=192.168.1.5
