# Copy to .env (never commit .env). Real values come from your own secrets, not this file.
PORT=3000
DATABASE_URL=postgres://toms_user:CHANGE_ME@localhost:5432/toms_db

# Signs login tokens. At least 32 characters; the server refuses to start with a short or
# placeholder value. Generate one with:  openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Comma-separated browser origins allowed to call the API, for example the dashboard URL.
# Leave empty to allow none. There is no wildcard.
CORS_ORIGINS=http://localhost:5173

# Used by docker-compose.yml
POSTGRES_USER=toms_user
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=toms_db
