# Copy this file to deploy/.env on the server and fill in the CHANGE_ME values.
# Never commit deploy/.env (it is ignored by deploy/.gitignore).

# Printed into every card QR code. Set it once, before the first print run, and do not change it afterwards.
PUBLIC_BASE_URL=https://toms.perchbuilds.me
REPORT_TIMEZONE=Asia/Manila

POSTGRES_USER=toms
POSTGRES_DB=toms
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Signs login tokens. Generate with: openssl rand -hex 32  (the server refuses short or placeholder values)
JWT_SECRET=CHANGE_ME

# Seals the Return Machine signing keys at rest (AES-256-GCM). Leave it blank to keep Return Machine key issuing off: the
# Return Machine routes then answer 503 and nothing is stored or served. To turn it on, set exactly 64 hex characters
# (32 bytes); the API refuses to start on a malformed value. Generate one with:  openssl rand -hex 32
# Back it up with the other server secrets: if it is lost or changed, every sealed machine key becomes unreadable and each
# machine's key must be re-issued. Do not reuse JWT_SECRET.
RM_KEY_MASTER_KEY=
