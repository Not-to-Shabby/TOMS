# Copy this file to deploy/.env on the server and fill in the CHANGE_ME values.
# Never commit deploy/.env (it is ignored by deploy/.gitignore).

# Printed into every card QR code. Set it once, before the first print run, and do not change it afterwards.
PUBLIC_BASE_URL=https://toms.perchbuilds.me
REPORT_TIMEZONE=Asia/Manila

POSTGRES_USER=toms
POSTGRES_DB=toms
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Signs login tokens. Generate with: openssl rand -hex 32  (the server refuses short or placeholder values)
JWT_SECRET=CHANGE_ME
