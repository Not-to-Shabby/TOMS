# TOMS Return Machine — application options

mainmenu "TOMS Return Machine"

menu "TOMS Return Machine"

choice
	prompt "Return Machine LCD Interface Mode"
	default TOMS_UI_PASSENGER

config TOMS_UI_PASSENGER
	bool "Passenger In-Service UI (Deployment)"
	help
	  In-service transit screen for passengers: "TAP CARD TO EXIT"
	  idle prompt with live clock, big green "FARE PAID - THANK YOU",
	  red "UNPAID FARE - SEE CONDUCTOR", and amber "ALREADY SCANNED".

config TOMS_UI_DIAGNOSTIC
	bool "Hardware Diagnostic Test Bench UI (Bench/QC)"
	help
	  Technician bench test: auto-cycling color pages, hardware telemetry,
	  and diagnostic tools dashboard.
endchoice

config TOMS_BACKLIGHT_ACTIVE_HIGH
	bool "Backlight is on when GPIO13 is high"
	default n
	help
		The built board uses a PNP (2N3906) high-side switch: base low =
		backlight on, so GPIO13 low is "on". The Fritzing sketch still
		shows an NPN; enable this only for that wiring.

config TOMS_PAID_TIMEOUT_MS
	int "Paid-check timeout in milliseconds (brief allows 1000-2000)"
	default 1500
	range 1000 2000

config TOMS_HEARTBEAT_INTERVAL_S
	int "Heartbeat interval in seconds"
	default 10
	range 1 120

config TOMS_RING_CAPACITY
	int "Offline card-read ring capacity (entries)"
	default 256

config TOMS_STATE_TABLE_CAPACITY
	int "Cached card state table capacity (entries)"
	default 64

config TOMS_DEV_MODE
	bool "Development mode (unbonded centrals accepted, dev key)"
	default n
	help
		Never enable in a field build. Exists only so the spike and bench
		tests can run before enrollment is designed.

config TOMS_BUILD_TAG
	string "Name printed at boot to tell images apart"
	default "dev"
	help
		Shown in the boot log and by the OTA tests ("good-1", "bad-crash", ...).

config TOMS_WATCHDOG_TIMEOUT_MS
	int "Watchdog timeout in milliseconds"
	default 8000
	range 2000 60000
	help
		The watchdog resets the SoC unless the NFC, display and main tasks all show
		progress within this time. Must be long enough for a PN532 init retry (5 s).

config TOMS_SELFTEST_GOOD_CHECKS
	int "Healthy checks in a row before a trial image confirms itself"
	default 5
	range 1 100
	help
		A check runs every second. 5 means 5 s of Bluetooth up, display up and every
		monitored task running before the image is confirmed.

config TOMS_SELFTEST_DEADLINE_MS
	int "Self-test deadline in milliseconds"
	default 30000
	range 5000 120000
	help
		If a trial image is not healthy by then, it resets so the old image comes back.

choice TOMS_TRIAL_FAULT
	prompt "Bench fault injection for the OTA revert test (NEVER in a real build)"
	default TOMS_TRIAL_FAULT_NONE

config TOMS_TRIAL_FAULT_NONE
	bool "None"

config TOMS_TRIAL_FAULT_CRASH
	bool "Crash a trial image at boot (null write)"

config TOMS_TRIAL_FAULT_HANG
	bool "Hang a trial image at boot with the watchdog armed and unfed"

config TOMS_TRIAL_FAULT_NO_CONFIRM
	bool "Trial image runs fine but never confirms itself"

config TOMS_TRIAL_FAULT_SELFTEST_FAIL
	bool "Trial image runs but its self-test always fails"

endchoice

endmenu

# An app-level Kconfig is the root of the Kconfig universe, so the Zephyr
# core must be sourced from here.
source "Kconfig.zephyr"
