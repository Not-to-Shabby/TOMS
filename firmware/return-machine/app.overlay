/*
 * TOMS Return Machine — devicetree overlay
 *
 * Pins verified against the Fritzing netlist (firmware/HW_NOTES.md):
 *   PN532 I2C SDA GPIO2, SCL GPIO7, IRQ GPIO5 (RSTO unconnected)
 *   Button GPIO4 (10K pull-up + 100nF, active low)
 *   Buzzer GPIO6 (low-side NPN, high = tone on)
 *   LCD CS 10, MOSI 11, SCLK 12, DC 9, RST 8, backlight GPIO13
 *   Battery sense hook: GPIO1 (nothing wired yet)
 *
 * The board is the closest upstream definition (esp32s3_devkitc); every pin
 * above is set here, none is inherited from the devkit.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/pinctrl/esp-pinctrl-common.h>
#include <dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include <zephyr/dt-bindings/pinctrl/esp32s3-gpio-sigmap.h>

/ {
	/* The Super Mini only exposes the native USB-C port, so the console and
	 * shell go there instead of the devkit's UART0 pins. */
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	leds {
		compatible = "gpio-leds";

		buzzer: buzzer {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
		};

		backlight: backlight {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		return_button: button_0 {
			gpios = <&gpio0 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/* Battery sense hook: GPIO1 (ADC1_CH0). Nothing is wired yet — add the
	 * channel node together with the hardware divider (HW_NOTES.md). */

	display_mipi_dbi: mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
	};
};

&usb_serial {
	status = "okay";
};

&uart0 {
	status = "disabled";
};

/* The pinctrl driver reads pins from child group nodes only. The board file
 * already defines i2c0_default and spim3_default with the devkit's pins, so
 * pinmux set on those nodes directly is ignored. These are new nodes that
 * the buses are pointed at below. */
&pinctrl {
	i2c0_toms: i2c0_toms {
		group1 {
			pinmux = <I2C0_SDA_GPIO2>, <I2C0_SCL_GPIO7>;
			bias-pull-up;
			drive-open-drain;
			output-high;
		};
	};

	spim3_toms: spim3_toms {
		group1 {
			pinmux = <SPIM3_SCLK_GPIO12>;
		};
		group2 {
			pinmux = <SPIM3_MOSI_GPIO11>;
			output-low;
		};
	};
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_toms>;
	pinctrl-names = "default";

	pn532: pn532@24 {
		compatible = "toms,pn532";
		reg = <0x24>;
		irq-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
	};
};

&spi3 {
	status = "okay";
	pinctrl-0 = <&spim3_toms>;
	pinctrl-names = "default";
	cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
	clock-frequency = <16000000>;
};

/* ST7735S 160x128, write only (MISO unconnected per the netlist).
 * Offsets and inversion depend on the module variant; bench will confirm. */
&display_mipi_dbi {
	compatible = "zephyr,mipi-dbi-spi";
	status = "okay";
	dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
	reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
	spi-dev = <&spi3>;
	write-only;
	#address-cells = <1>;
	#size-cells = <0>;

	lcd: st7735s@0 {
		compatible = "sitronix,st7735r";
		reg = <0>;
		mipi-max-frequency = <16000000>;
		mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
		width = <160>;
		height = <128>;
		/* The ESP-IDF slave project (archive/esp32_slave) drove this panel with
		 * no window offset and inversion off. */
		x-offset = <0>;
		y-offset = <0>;
		madctl = <0x60>;  /* landscape, RGB order */
		colmod = <0x55>;  /* 16-bit pixels, matches the driver's 2 bytes per pixel */
		/* Starting gamma values for a red-tab style panel; tune on the bench. */
		gamctrp1 = [02 1c 07 12 37 32 29 2d 29 25 2B 39 00 01 03 10];
		gamctrn1 = [03 1d 07 06 2E 2C 29 2D 2E 2E 37 3F 00 00 02 10];
	};
};
